# ------------------------------------------------ #
# Étape 1 — Build du rootfs Alpine 3.24            #
#           + installation de s6-overlay           #
# ------------------------------------------------ #

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS builder

# Arguments Buildx (auto fournis : TARGETARCH, TARGETPLATFORM)
ARG TARGETARCH
ARG TARGETPLATFORM

# Variables globales
ENV REL=v3.24
ENV ARCH=${TARGETARCH}
ENV MIROIR=https://dl-cdn.alpinelinux.org/alpine

ARG S6_OVERLAY_VERSION=3.2.3.2
ARG S6_SHA256_NOARCH=5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12
ARG S6_SHA256_X86_64=e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408
ARG S6_SHA256_AARCH64=b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c

# Installer les outils nécessaires
# hadolint ignore=DL3018
RUN apk add --no-cache curl tar xz

# Construire le rootfs Alpine.
# hadolint ignore=DL3018
RUN echo "**** Build rootfs Alpine (${REL}) pour ${ARCH} ****" && \
    case "${ARCH}" in \
        amd64) APK_ARCH=x86_64  ;; \
        arm64) APK_ARCH=aarch64 ;; \
        *) echo "Architecture non prise en charge : ${ARCH}" >&2; exit 1 ;; \
    esac && \
    mkdir -p /rootfs/etc/apk && \
    printf '%s/%s/main\n%s/%s/community\n' \
        "${MIROIR}" "${REL}" "${MIROIR}" "${REL}" > /rootfs/etc/apk/repositories && \
    apk --root /rootfs --keys-dir /etc/apk/keys --arch "${APK_ARCH}" \
        --initdb --no-cache add \
        alpine-baselayout \
        alpine-keys \
        apk-tools \
        busybox \
        libc-utils && \
    sed -i 's/^root::/root:!:/' /rootfs/etc/shadow && \
    grep -q '^root:!' /rootfs/etc/shadow && \
    rm -rf /rootfs/var/log/* /rootfs/var/cache/apk/* /rootfs/root/.ash_history

# Installer s6-overlay dans le rootfs.
RUN echo "**** Installation de s6-overlay v${S6_OVERLAY_VERSION} pour ${ARCH} ****" && \
    case "${ARCH}" in \
        amd64) S6_ARCH=x86_64;  S6_SHA_ARCH="${S6_SHA256_X86_64}"  ;; \
        arm64) S6_ARCH=aarch64; S6_SHA_ARCH="${S6_SHA256_AARCH64}" ;; \
        *) echo "Architecture non supportée : ${ARCH}" >&2; exit 1  ;; \
    esac && \
    S6_URL="https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}" && \
    curl -fsSL -o /tmp/s6-noarch.tar.xz "${S6_URL}/s6-overlay-noarch.tar.xz" && \
    curl -fsSL -o /tmp/s6-arch.tar.xz "${S6_URL}/s6-overlay-${S6_ARCH}.tar.xz" && \
    printf '%s  /tmp/s6-noarch.tar.xz\n%s  /tmp/s6-arch.tar.xz\n' \
        "${S6_SHA256_NOARCH}" "${S6_SHA_ARCH}" > /tmp/s6.sha256 && \
    sha256sum -c /tmp/s6.sha256 && \
    tar -C /rootfs -Jxpf /tmp/s6-noarch.tar.xz && \
    tar -C /rootfs -Jxpf /tmp/s6-arch.tar.xz && \
    rm -f /tmp/s6-noarch.tar.xz /tmp/s6-arch.tar.xz /tmp/s6.sha256

# -------------------------------------- #
# Étape 2 — Image finale Alpine minimale #
# -------------------------------------- #

FROM scratch

ARG TARGETARCH
ARG BUILD_DATE
ARG REPO_URL=https://github.com/Sam-Tech-Lab-OSS/Docker-Alpine-3.24-S6-Overlay
ARG AUTHORS="Sam Tech Lab"
ARG TITLE="Alpine 3.24 Base - s6-overlay"
ARG DESCRIPTION="Image Alpine 3.24 légère, durcie et multi-architecture, avec s6-overlay"
ARG VERSION="3.24"
ARG LICENSES="Apache-2.0"

# Copier le rootfs préparé (Alpine + s6-overlay)
COPY --from=builder /rootfs/ /

# -------------------------- #
# Labels conformes OCI       #
# -------------------------- #
LABEL maintainer="$AUTHORS" \
      org.opencontainers.image.title="$TITLE" \
      org.opencontainers.image.description="$DESCRIPTION" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.architecture=$TARGETARCH \
      org.opencontainers.image.authors="$AUTHORS" \
      org.opencontainers.image.licenses="$LICENSES" \
      org.opencontainers.image.source=$REPO_URL \
      org.opencontainers.image.created=$BUILD_DATE

# --------------------------- #
# Environnement global        #
# --------------------------- #

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm \
    TZ=UTC \
    PATH="/command:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# --------------------------------------------------- #
# Comportement de s6-overlay                          #
# --------------------------------------------------- #
# S6_BEHAVIOUR_IF_STAGE2_FAILS=2 : le conteneur s'ARRÊTE si un script
#   d'init échoue, au lieu de continuer silencieusement (défaut = 0).
#   Sans cela, un échec du remappage PUID/PGID passerait inaperçu et
#   laisserait /config avec de mauvaises permissions.
# S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 : aucun délai maximal imposé aux
#   services pour démarrer (0 = attente illimitée).
# S6_VERBOSITY=1 : n'affiche que les avertissements et les erreurs.
ENV S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_VERBOSITY=1

# ------------------ #
# Paquets essentiels #
# ------------------ #
# hadolint ignore=DL3018
RUN set -eux && \
    echo "**** Installation des paquets de base ****" && \
    apk upgrade --no-cache && \
    apk add --no-cache \
        alpine-release \
        bash \
        ca-certificates \
        coreutils \
        curl \
        findutils \
        jq \
        netcat-openbsd \
        shadow \
        tzdata && \
    update-ca-certificates

# -------------------------------------------------- #
# Sécurité & utilisateur non-root (production-grade) #
# -------------------------------------------------- #

ENV PUID=1000 \
    PGID=1000 \
    HOME=/config

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux && \
    echo "**** Création utilisateur sécurisé ****" && \
    NOLOGIN="$(command -v nologin || echo /sbin/nologin)" && \
    if [ ! -x "${NOLOGIN}" ]; then echo "nologin introuvable : ${NOLOGIN}"; exit 1; fi && \
    if ! command -v getent >/dev/null; then echo "getent introuvable : la garde UID/GID serait inopérante"; exit 1; fi && \
    if getent passwd "${PUID}" >/dev/null; then \
        CONFLIT="$(getent passwd "${PUID}" | cut -d: -f1)"; \
        echo "**** UID ${PUID} occupé par ${CONFLIT} — suppression ****"; \
        userdel -r "${CONFLIT}" >/dev/null 2>&1 || true; \
        if getent passwd "${PUID}" >/dev/null; then echo "UID ${PUID} toujours occupé"; exit 1; fi; \
    fi && \
    if getent group "${PGID}" >/dev/null; then \
        CONFLIT="$(getent group "${PGID}" | cut -d: -f1)"; \
        echo "**** GID ${PGID} occupé par ${CONFLIT} — suppression ****"; \
        groupdel "${CONFLIT}" >/dev/null 2>&1 || true; \
        if getent group "${PGID}" >/dev/null; then echo "GID ${PGID} toujours occupé"; exit 1; fi; \
    fi && \
    groupadd -g ${PGID} appuser && \
    useradd -l -u ${PUID} -g ${PGID} -d /config -s "${NOLOGIN}" appuser && \
    mkdir -p /config && chown -R appuser:appuser /config && chmod 750 /config && \
    echo 'umask 027' >> /etc/profile && \
    { find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} + 2>/dev/null || true; } && \
    { find / -xdev -type f -perm /0002 -exec chmod o-w {} + 2>/dev/null || true; } && \
    chmod 700 /root && \
    id appuser && \
    echo "**** User appuser ready (UID=${PUID}, GID=${PGID}) ****"

# --------------------------------------------------- #
# Services et scripts d'init s6-rc                    #
# --------------------------------------------------- #
COPY root/ /

RUN set -eux && \
    chmod 755 /etc/s6-overlay/scripts/*

# --------------- #
# Nettoyage final #
# --------------- #
RUN set -eux && \
    echo "**** Nettoyage du système ****" && \
    rm -rf /tmp/* /var/tmp/* /var/log/* /var/cache/apk/*

ENTRYPOINT ["/init"]

CMD ["/command/s6-setuidgid", "appuser", "/bin/bash"]
